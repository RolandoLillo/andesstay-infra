# Credenciales y configuracion de la orquestacion AndesStay (Fase 4)
# Copiar este archivo a .env y ajustar los valores antes de levantar:
#   cp .env.example .env   (Windows: copy .env.example .env)
#
# ADVERTENCIA: en produccion, reemplazar las credenciales por secretos
# (AWS Secrets Manager / variables de CI/CD). Nunca commitear el .env real.

# --- PostgreSQL ---
POSTGRES_DB=andesstay_db
POSTGRES_USER=andesstay_user
POSTGRES_PASSWORD=andesstay_super_secret
POSTGRES_PORT=5432

# --- RabbitMQ (clúster de 2 nodos: rabbitmq-1 + rabbitmq-2) ---
RABBITMQ_USERNAME=andesstay_notify
RABBITMQ_PASSWORD=andesstay_super_secret
# Cookie Erlang compartida: TODOS los nodos del clúster deben usar el mismo valor.
RABBITMQ_ERLANG_COOKIE=andesstay_erlang_cookie_change_me

# --- Notify / Kafka ---
# poner true para encender el consumidor de reservations.activity; hoy no hay productor en main de reservations (R-02/R-05 pendientes)
NOTIFY_KAFKA_AUTO_STARTUP=false

# --- Puertos de publicacion a nivel de servicio ---
# En produccion (EC2), el API Gateway necesita alcanzar el BFF:
#   BFF_PUBLIC_HOST=0.0.0.0
BFF_PUBLIC_HOST=0.0.0.0
BFF_PORT=8080

# Puertos opcionales para pruebas locales (no publicar en EC2; usar docker exec)
RESERVATIONS_PORT=8082
CATALOG_PORT=8081

# --- Frontend HTTPS (Caddy + sslip.io) ---
# Usar la Elastic IP con guiones; Caddy publica 80/443, el contenedor frontend queda interno.
FRONTEND_DOMAIN=54-211-241-28.sslip.io
ANDESSTAY_API_URL=https://lmv59t05gg.execute-api.us-east-1.amazonaws.com/prod/api

# --- AWS API Gateway existente (ver aws/api-gateway/http-api.yml) ---
AWS_REGION=us-east-1
AWS_API_ID=lmv59t05gg
AWS_TENANT_ID=<TU_TENANT_ID_ENTRA_ID>
AWS_API_CLIENT_ID=<CLIENT_ID_API_ENTRA_ID>
AWS_API_ENDPOINT=https://lmv59t05gg.execute-api.us-east-1.amazonaws.com/prod/api
AWS_EC2_PUBLIC_IP=<IP_PUBLICA_EC2>
