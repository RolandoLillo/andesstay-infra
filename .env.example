# Credenciales y configuracion de la orquestacion AndesStay (Fase 4)
# Copiar este archivo a .env y ajustar los valores antes de levantar:
#   cp .env.example .env   (Windows: copy .env.example .env)
#
# ADVERTENCIA: en produccion, reemplazar las credenciales por secretos
# (AWS Secrets Manager / variables de CI/CD). Nunca commitear el .env real.

# --- PostgreSQL ---
POSTGRES_DB=andesstay_db
POSTGRES_USER=andesstay_user
POSTGRES_PASSWORD=andesstay_super_secret
POSTGRES_PORT=5432

# --- Puertos de publicacion a nivel de servicio ---
# En produccion (EC2), el API Gateway necesita alcanzar el BFF:
#   BFF_PUBLIC_HOST=0.0.0.0
BFF_PUBLIC_HOST=127.0.0.1
BFF_PORT=8080

# Puertos opcionales para pruebas locales (descomentar en compose.yml)
RESERVATIONS_PORT=8082
CATALOG_PORT=8081

# --- AWS API Gateway (ver aws/api-gateway/http-api.yml) ---
AWS_REGION=us-east-1
AWS_TENANT_ID=<TU_TENANT_ID_ENTRA_ID>
AWS_API_CLIENT_ID=<CLIENT_ID_API_ENTRA_ID>
AWS_API_ENDPOINT=https://<API_ID>.execute-api.<AWS_REGION>.amazonaws.com
AWS_EC2_PUBLIC_IP=<IP_PUBLICA_EC2>